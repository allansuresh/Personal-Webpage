---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, stack, status, repoUrl, demoUrl, writeupUrl } = project.data;
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <header class="header">
      <p class="field">
        <a href="/projects/">← projects</a>
      </p>
      <p class="field meta">
        <span class={`dot ${status === 'active' ? '' : 'dot--flag'}`} />
        status — {status}
        <span class="sep">·</span>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      {stack.length > 0 && (
        <p class="stack">
          {stack.map((s: string) => (
            <span class="tag">{s}</span>
          ))}
        </p>
      )}

      <p class="links">
        {repoUrl && (
          <a class="button button--ghost" href={repoUrl} target="_blank" rel="noreferrer">
            View code →
          </a>
        )}
        {demoUrl && (
          <a class="button button--ghost" href={demoUrl} target="_blank" rel="noreferrer">
            Live demo →
          </a>
        )}
        {writeupUrl && (
          <a class="button button--ghost" href={writeupUrl} target="_blank" rel="noreferrer">
            Full write-up →
          </a>
        )}
      </p>
    </header>

    <hr class="rule" />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .header {
    padding-top: var(--space-4);
    max-width: var(--measure);
  }

  .header .field a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .header .field a:hover {
    color: var(--signal);
  }

  .meta {
    margin-top: var(--space-2);
  }

  .meta .sep {
    color: var(--line-strong);
    margin: 0 0.5em;
  }

  h1 {
    margin-top: var(--space-2);
  }

  .summary {
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-top: var(--space-2);
  }

  .links {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .button {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
    padding: 0.55em 0.9em;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .button:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  article {
    padding-bottom: var(--space-6);
  }
</style>
