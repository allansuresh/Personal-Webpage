---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, tags, project } = post.data;

const relatedProject = project ? await getEntry('projects', project) : undefined;
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <header class="header">
      <p class="field">
        <a href="/blog/">← writing</a>
      </p>
      <p class="field meta">
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      {tags.length > 0 && (
        <p class="stack">
          {tags.map((t: string) => (
            <span class="tag">{t}</span>
          ))}
        </p>
      )}

      {relatedProject && (
        <p class="related field">
          <span class="dot" aria-hidden="true" /> related project —{' '}
          <a href={`/projects/${relatedProject.id}/`}>{relatedProject.data.title}</a>
        </p>
      )}
    </header>

    <hr class="rule" />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .header {
    padding-top: var(--space-4);
    max-width: var(--measure);
  }

  .header .field a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .header .field a:hover {
    color: var(--signal);
  }

  .meta {
    margin-top: var(--space-2);
    color: var(--ink-faint);
  }

  h1 {
    margin-top: var(--space-2);
  }

  .summary {
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-top: var(--space-2);
  }

  .related {
    margin-top: var(--space-2);
  }

  .related a {
    color: var(--signal);
    text-decoration: none;
  }

  article {
    padding-bottom: var(--space-6);
  }
</style>
